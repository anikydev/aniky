import kotlin.Boolean;

CREATE TABLE custom_buttons (
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    isFavorite INTEGER AS Boolean NOT NULL,
    sortIndex INTEGER NOT NULL,
    content TEXT NOT NULL,
    longPressContent TEXT NOT NULL,
    onStartup TEXT NOT NULL
);

-- Insert the default skip button --
-- The jump length lives in an mpv property that the app seeds from a preference (so it persists
-- across sessions); int_picker writes the picked value straight back to that same property, the app
-- observes it to save, and the startup observer keeps the button label in sync.
--
-- Both scripts reject values below 1 rather than leaning on `or 85`: 0 is truthy in Lua, so a
-- property that somehow holds 0 would otherwise make the button seek nowhere and label itself "+0 s".
INSERT OR IGNORE INTO custom_buttons (_id, name, isFavorite, sortIndex, content, longPressContent, onStartup)
VALUES (1, '+85 s', 1, 0, 'local n = math.floor(mp.get_property_number("user-data/aniky/skip-seconds") or 0)
if n < 1 then n = 85 end
aniyomi.seek_by_with_text(n, "Skipped " .. n .. " s")', 'aniyomi.int_picker("Skip amount", "%ds", 5, 300, 5, "user-data/aniky/skip-seconds")', 'if $isPrimary then
  mp.observe_property("user-data/aniky/skip-seconds", "number", function(_, n)
    if n ~= nil and n >= 1 then
      aniyomi.set_button_title("+" .. math.floor(n) .. " s")
    end
  end)
end');

findAll:
SELECT *
FROM custom_buttons
ORDER BY sortIndex;

insert:
INSERT INTO custom_buttons(name, isFavorite, sortIndex, content, longPressContent, onStartup)
VALUES (:name, :isFavorite, :sortIndex, :content, :longPressContent, :onStartup);

delete:
DELETE FROM custom_buttons
WHERE _id = :customButtonId;

update:
UPDATE custom_buttons
SET name = coalesce(:name, name),
    isFavorite = coalesce(:isFavorite, isFavorite),
    sortIndex = coalesce(:sortIndex, sortIndex),
    content = coalesce(:content, content),
    longPressContent = coalesce(:longPressContent, longPressContent),
    onStartup = coalesce(:onStartup, onStartup)
WHERE _id = :customButtonId;

selectLastInsertedRowId:
SELECT last_insert_rowid();
